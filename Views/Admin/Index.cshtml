@model PROJECT2106.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Panel";
}

<h2>Admin Panel</h2>

<div style="display: flex; gap: 20px; margin-bottom: 30px;">
    <div style="border: 1px solid #ccc; padding: 20px; border-radius: 8px; text-align: center;">
        <h3>@Model.UserCount</h3>
        <p>Users</p>
    </div>
    <div style="border: 1px solid #ccc; padding: 20px; border-radius: 8px; text-align: center;">
        <h3>@Model.PostCount</h3>
        <p>Posts</p>
    </div>
    <div style="border: 1px solid #ccc; padding: 20px; border-radius: 8px; text-align: center;">
        <h3>@Model.CommentCount</h3>
        <p>Comments</p>
    </div>
</div>

<h4>User List</h4>
<table style="width: 100%; border-collapse: collapse;">
    <tr style="background: #f5f5f5;">
        <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Name</th>
        <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Email</th>
        <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Registered </th>
    </tr>
    @foreach (var user in Model.Users.Items)
    {
        <tr>
            <td style="padding: 10px; border: 1px solid #ddd;">@user.UserName</td>
            <td style="padding: 10px; border: 1px solid #ddd;">@user.Email</td>
            <td style="padding: 10px; border: 1px solid #ddd;">@user.CreatedAt.ToString("dd.MM.yyyy")</td>
        </tr>
    }
</table>

@if (Model.Users.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination">
            <li class="page-item @(Model.Users.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Users.Page - 1)">
                    Previous
                </a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">
                    @Model.Users.Page / @Model.Users.TotalPages
                </span>
            </li>

            <li class="page-item @(Model.Users.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Users.Page + 1)">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}
