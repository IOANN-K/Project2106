@model IReadOnlyList<PROJECT2106.Models.CustomCategory>
@{ ViewData["Title"] = "Custom Categories"; }
<div class="page-shell page-shell-narrow"><header class="page-header"><div><p class="page-eyebrow">Personal taxonomy</p><h1 class="page-title page-title-sm">Custom categories</h1><p class="page-subtitle">Organize discoveries that do not fit the standard map categories.</p></div><a asp-action="Create" class="btn btn-primary">New category</a></header>@if (Model.Count == 0) { <div class="empty-state"><h2>No custom categories</h2><p>Create one when your discovery needs its own label.</p></div> } else { <div class="place-results">@foreach (var category in Model) { <div class="place-card"><strong>@category.Name</strong><form method="post" asp-action="Delete"><input type="hidden" name="id" value="@category.Id" /><button type="submit" class="btn btn-sm btn-outline-danger">Remove</button></form></div> }</div> }</div>
