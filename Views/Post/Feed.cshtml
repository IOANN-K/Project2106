@model PROJECT2106.ViewModels.PagedResult<PROJECT2106.ViewModels.FeedItemViewModel>
@using PROJECT2106.Models

@{
    ViewData["Title"] = "My Feed";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">My Feed</h1>

        <p class="text-muted mb-0">
            New contributions from explorers you follow.
        </p>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">

                <h2 class="h5">
                    Your feed is empty
                </h2>

                <p class="text-muted mb-3">
                    Follow other explorers to see their latest
                    contributions here.
                </p>

                <a asp-controller="Profile"
                   asp-action="Search"
                   class="btn btn-primary">
                    Find explorers
                </a>

                <a asp-controller="Map"
                   asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Explore map
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="d-grid gap-3">

            @foreach (var item in Model.Items)
            {
                <article class="card">
                    <div class="card-body">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    gap-3
                                    mb-3">

                            <div>
                                <strong>
                                    @item.AuthorUsername
                                </strong>

                                <div class="small text-muted">
                                    @item.CreatedAt.ToString("dd MMM yyyy, HH:mm")

                                    @if (item.IsEdited)
                                    {
                                        <span>· edited</span>
                                    }
                                </div>
                            </div>

                            <span class="badge bg-secondary">
                                @item.Category
                            </span>

                        </div>

                        <div class="small text-muted mb-2">
                            Contribution to

                            <a asp-controller="Place"
                               asp-action="Details"
                               asp-route-id="@item.PlaceId">
                                @item.PlaceName
                            </a>
                        </div>

                        <p style="white-space: pre-wrap;">
                            @item.Excerpt
                        </p>

                        @if (item.Media != null)
                        {
                            <div class="mb-3"
                                 style="max-width: 640px;">

                                @if (item.Media.MediaType == PostMediaType.Image)
                                {
                                    <img src="@item.Media.RelativePath"
                                         alt="@item.Media.OriginalFileName"
                                         class="img-fluid rounded post-media-image"
                                         loading="lazy"
                                         style="width:100%;
                                                max-height:360px;
                                                object-fit:cover;" />

                                    <div class="post-media-fallback
                                                alert alert-secondary
                                                d-none mb-0">
                                        Image unavailable
                                    </div>
                                }
                                else
                                {
                                    <video controls
                                           preload="metadata"
                                           class="w-100 rounded post-media-video"
                                           style="max-height:360px;">

                                        <source src="@item.Media.RelativePath"
                                                type="@item.Media.MimeType" />

                                    </video>

                                    <div class="post-media-fallback
                                                alert alert-secondary
                                                d-none mb-0">
                                        Video unavailable
                                    </div>
                                }

                            </div>
                        }

                        <div class="d-flex
                                    flex-wrap
                                    justify-content-between
                                    align-items-center
                                    gap-2">

                            <div class="small text-muted">
                                👍 @item.LikeCount
                                ·
                                💬 @item.CommentCount
                            </div>

                            <div class="d-flex gap-2">

                                <a asp-controller="Post"
                                   asp-action="Details"
                                   asp-route-id="@item.PostId"
                                   class="btn btn-sm btn-outline-secondary">
                                    Open post
                                </a>

                                <a asp-controller="Place"
                                   asp-action="Details"
                                   asp-route-id="@item.PlaceId"
                                   class="btn btn-sm btn-primary">
                                    Open place
                                </a>

                            </div>

                        </div>

                    </div>
                </article>
            }

        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination">

                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Feed"
                       asp-route-page="@(Model.Page - 1)">
                        Previous
                    </a>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">
                        @Model.Page / @Model.TotalPages
                    </span>
                </li>

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Feed"
                       asp-route-page="@(Model.Page + 1)">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>
