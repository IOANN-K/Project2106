@model List<PROJECT2106.Models.Post>
@{
    ViewData["Title"] = "My Feed";
}
<h2>My Feed</h2>

@if (!Model.Any())
{
    <p>No posts yet. Follow some users to see their posts here!</p>
}
else
{
    foreach (var post in Model)
    {
        <div style="border: 1px solid #ccc; padding: 15px; margin: 10px 0; border-radius: 8px;">
            <p><strong>@post.Author?.UserName</strong></p>
            <p>@post.Content</p>
            <small>@post.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
            @if (post.Tags != null && post.Tags.Any())
            {
                <div style="margin-top:5px;">
                    @foreach (var tag in post.Tags)
                    {
                        <a asp-action="Index" asp-route-tag="@tag.Name" class="badge bg-secondary text-decoration-none" style="margin-right:3px;">@tag.Name</a>
                    }
                </div>
            }
            <br />
            <a asp-action="Details" asp-route-id="@post.Id">Comments (@(post.Comments?.Count ?? 0))</a>
        </div>
    }
}