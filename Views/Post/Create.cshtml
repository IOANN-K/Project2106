@model PROJECT2106.ViewModels.PostCreateViewModel

@{
    ViewData["Title"] = "New Post";
}

<h2>New Post</h2>

<form method="post"
      enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="PlaceId" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="alert alert-secondary">
        Posting to:
        <strong>@Model.PlaceName</strong>
    </div>

    <span asp-validation-for="PlaceId"
        class="text-danger d-block"></span>

    <div style="margin-bottom: 10px;">
        <label asp-for="Content">Content:</label>
        <br />
        <textarea asp-for="Content"
                  rows="4"
                  style="width: 100%; max-width: 600px;"></textarea>
        <br />
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <div style="margin-bottom: 10px;">
        <label asp-for="Tags">Tags (comma separated):</label>
        <br />
        <input asp-for="Tags"
               type="text"
               style="width: 100%; max-width: 600px;"
               placeholder="technology, sports, news" />
        <br />
        <span asp-validation-for="Tags" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MediaFiles" class="form-label">
            Images / videos
        </label>

        <input asp-for="MediaFiles"
               type="file"
               class="form-control"
               multiple
               accept=".jpg,.jpeg,.png,.webp,.mp4,.webm,image/jpeg,image/png,image/webp,video/mp4,video/webm" />

        <span asp-validation-for="MediaFiles"
              class="text-danger"></span>

        <div class="form-text">
            Up to 10 files. Images up to 10 MB, videos up to 50 MB.
        </div>
    </div>

    <button type="submit" style="padding: 8px 20px;">Publish</button>
    <a asp-controller="Place"
        asp-action="Details"
        asp-route-id="@Model.PlaceId"
        style="margin-left: 10px;">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
