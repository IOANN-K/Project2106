@model PROJECT2106.Models.Post
@{ ViewData["Title"] = "Delete Contribution"; }
<div class="page-shell page-shell-narrow"><a asp-action="Details" asp-route-id="@Model.Id" class="breadcrumb-link">← Back to contribution</a><header class="page-header"><div><p class="page-eyebrow text-danger">Destructive action</p><h1 class="page-title page-title-sm">Delete this contribution?</h1><p class="page-subtitle">This action cannot be undone.</p></div></header><div class="danger-panel"><p class="pre-line">@Model.Content</p><small class="text-muted">Published @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small><form method="post" class="action-toolbar mt-4">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Yes, delete</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div></div>
