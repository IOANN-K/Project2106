@model PROJECT2106.Models.Post

@{
    ViewData["Title"] = "Post";
}

<h2>Post #@Model.Id</h2>

<div style="border: 1px solid #ccc; padding: 15px; border-radius: 8px;">
    <p>@Model.Content</p>
    <small>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
    @if (User.Identity!.IsAuthenticated)
    {
        <form method="post" asp-controller="Like" asp-action="ToggleLike" style="display:inline;">
            <input type="hidden" name="postId" value="@Model.Id" />
            <input type="hidden" name="isLike" value="true" />
            <button type="submit" class="btn btn-sm btn-outline-success">👍 (@ViewBag.Likes)</button>
        </form>
        <form method="post" asp-controller="Like" asp-action="ToggleLike" style="display:inline;">
            <input type="hidden" name="postId" value="@Model.Id" />
            <input type="hidden" name="isLike" value="false" />
            <button type="submit" class="btn btn-sm btn-outline-danger">👎 (@ViewBag.Dislikes)</button>
        </form>
    }   
</div>
<div style="margin-top: 20px;">
    <h3>Comments</h3>

    @if (TempData["CommentError"] is string commentError)
    {
        <div class="alert alert-danger">@commentError</div>
    }
    @if (Model.Comments != null && Model.Comments.Any())
    {
        <ul>
            @foreach (var comment in Model.Comments.Where(c => c.ParentCommentId == null).OrderByDescending(c => c.CreatedAt))
            {
                await Html.RenderPartialAsync("_Comment", comment);
            }
        </ul>
        
    }
    else
    {
        <p>No comments yet.</p>
    }

    @if (User.Identity!.IsAuthenticated)
        {
            <form method="post" asp-controller="Post" asp-action="AddComment">
                <input type="hidden" name="postId" value="@Model.Id" />
                <textarea name="Content" required maxlength="2000" rows="3" style="width: 100%; max-width: 600px;" placeholder="Написати коментар..."></textarea>
                <br />
                <button type="submit" class="btn btn-primary mt-2">Додати коментар</button>
            </form>
        }
        @if (Model.AuthorId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value || User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" style="margin-right: 10px;">Edit Post</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" style="color: red;">Delete Post</a>
        }

    <script>
        function startEdit(id) {
            document.getElementById('comment-text-' + id).style.display = 'none';
            document.getElementById('comment-edit-form-' + id).style.display = 'block';
        }
        function cancelEdit(id) {
            document.getElementById('comment-text-' + id).style.display = 'inline';
            document.getElementById('comment-edit-form-' + id).style.display = 'none';
        }
        function toggleReply(id) {
        var form = document.getElementById('reply-form-' + id);
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }
    </script>
<br />
<a asp-controller="Post" asp-action="Index">← Back to Feed</a>