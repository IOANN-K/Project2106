@model PROJECT2106.ViewModels.PostEditViewModel

@{
    ViewData["Title"] = "Edit Post";
}

<h2>Edit Post</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="Id" type="hidden" />

    <div style="margin-bottom: 10px;">
        <label asp-for="Content">Content:</label>
        <br />
        <textarea asp-for="Content"
                  rows="4"
                  style="width: 100%; max-width: 600px;"></textarea>
        <br />
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <button type="submit" style="padding: 8px 20px;">Save</button>
    <a asp-action="Index" style="margin-left: 10px;">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
