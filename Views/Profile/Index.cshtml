@model PROJECT2106.Models.AppUser

@{
    ViewData["Title"] = "Profile";
}

<h2>Profile: @Model.UserName</h2>

<div style="border: 1px solid #ccc; padding: 15px; border-radius: 8px;">
    <p><strong>About:</strong> @Model.Bio</p>
    <p><strong>Registered:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy")</p>
</div>