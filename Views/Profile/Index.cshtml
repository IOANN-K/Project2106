@model PROJECT2106.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = $"Profile - {Model.User.UserName}";

    var username = Model.User.UserName ?? "Unknown";

    var initial = username.Length > 0
        ? username[..1].ToUpperInvariant()
        : "?";
}

<div class="container py-4">

    <div class="card mb-4">
        <div class="card-body">

            <div class="d-flex flex-column
                        flex-md-row
                        align-items-md-center
                        gap-4">

                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.User.AvatarUrl))
                    {
                        <img src="@Model.User.AvatarUrl"
                             alt="@username avatar"
                             class="rounded-circle"
                             style="width: 110px;
                                    height: 110px;
                                    object-fit: cover;"
                             loading="lazy"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                        <div class="rounded-circle bg-secondary text-white
                                    align-items-center justify-content-center"
                             style="width:110px;
                                    height:110px;
                                    font-size:2rem;
                                    display:none;">
                            @initial
                        </div>
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white
                                    d-flex align-items-center justify-content-center"
                             style="width:110px;
                                    height:110px;
                                    font-size:2rem;">
                            @initial
                        </div>
                    }
                </div>

                <div class="flex-grow-1">

                    <h1 class="h3 mb-1">
                        @username
                    </h1>

                    <div class="text-muted mb-3">
                        Joined @Model.User.CreatedAt.ToString("dd MMM yyyy")
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.User.Bio))
                    {
                        <p class="mb-3"
                           style="white-space:pre-wrap;">
                            @Model.User.Bio
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-3">
                            No bio yet.
                        </p>
                    }

                    <div class="d-flex flex-wrap gap-2">

                        @if (User.Identity?.IsAuthenticated == true &&
                             !Model.IsOwnProfile)
                        {
                            if (Model.IsFollowing)
                            {
                                <form method="post"
                                      asp-controller="Follow"
                                      asp-action="Unfollow">

                                    <input type="hidden"
                                           name="username"
                                           value="@Model.User.UserName" />

                                    <button type="submit"
                                            class="btn btn-outline-secondary">
                                        Unfollow
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post"
                                      asp-controller="Follow"
                                      asp-action="Follow">

                                    <input type="hidden"
                                           name="username"
                                           value="@Model.User.UserName" />

                                    <button type="submit"
                                            class="btn btn-primary">
                                        Follow
                                    </button>
                                </form>
                            }
                        }

                        <a asp-controller="Map"
                           asp-action="My"
                           class="btn btn-outline-primary">
                            My Map
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold">
                        @Model.Reputation
                    </div>
                    <div class="small text-muted">
                        Reputation
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="fw-bold">
                        @Model.ExplorerLevel
                    </div>
                    <div class="small text-muted">
                        Explorer level
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold">
                        @Model.CreatedPlacesCount
                    </div>
                    <div class="small text-muted">
                        Places
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold">
                        @Model.ContributionsCount
                    </div>
                    <div class="small text-muted">
                        Contributions
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold">
                        @Model.LikesReceived
                    </div>
                    <div class="small text-muted">
                        Likes received
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="fs-4 fw-bold">
                        @Model.CommentsCreated
                    </div>
                    <div class="small text-muted">
                        Comments
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-lg-2">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="fw-bold">
                        @Model.FollowersCount /
                        @Model.FollowingCount
                    </div>
                    <div class="small text-muted">
                        Followers / Following
                    </div>
                </div>
            </div>
        </div>

    </div>

    <section class="mb-5">

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <h2 class="h4 mb-0">
                Created places
            </h2>

            <span class="text-muted">
                @Model.CreatedPlacesCount
            </span>

        </div>

        @if (Model.CreatedPlaces.Count == 0)
        {
            <div class="card">
                <div class="card-body text-center py-4">
                    <p class="text-muted mb-0">
                        This explorer has not created any places yet.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">

                @foreach (var place in Model.CreatedPlaces)
                {
                    <div class="col-12 col-md-6">

                        <div class="card h-100">
                            <div class="card-body">

                                <h3 class="h5">
                                    @place.Name
                                </h3>

                                <div class="small text-muted mb-3">

                                    @if (place.SystemCategory.HasValue)
                                    {
                                        @place.SystemCategory.Value
                                    }
                                    else
                                    {
                                        <span>Custom category</span>
                                    }

                                    ·

                                    @place.CreatedAt.ToString("dd MMM yyyy")

                                </div>

                                <a asp-controller="Place"
                                   asp-action="Details"
                                   asp-route-id="@place.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Open place
                                </a>

                            </div>
                        </div>

                    </div>
                }

            </div>
        }

    </section>

    <section>

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <h2 class="h4 mb-0">
                Contributions
            </h2>

            <span class="text-muted">
                @Model.ContributionsCount
            </span>

        </div>

        @if (Model.Contributions.Count == 0)
        {
            <div class="card">
                <div class="card-body text-center py-5">

                    <h3 class="h5">
                        No contributions yet
                    </h3>

                    <p class="text-muted mb-0">
                        This explorer has not posted about any places yet.
                    </p>

                </div>
            </div>
        }
        else
        {
            <div class="d-grid gap-3">

                @foreach (var post in Model.Contributions)
                {
                    <article class="card">

                        <div class="card-body">

                            @if (post.Place != null)
                            {
                                <div class="small text-muted mb-2">
                                    Contribution to
                                    <a asp-controller="Place"
                                       asp-action="Details"
                                       asp-route-id="@post.Place.Id">
                                        @post.Place.Name
                                    </a>
                                </div>
                            }

                            <p style="white-space:pre-wrap;">
                                @post.Content
                            </p>

                            <div class="d-flex
                                        justify-content-between
                                        align-items-center
                                        gap-2">

                                <small class="text-muted">
                                    @post.CreatedAt.ToString("dd.MM.yyyy HH:mm")

                                    @if (post.IsEdited)
                                    {
                                        <span>· edited</span>
                                    }
                                </small>

                                <a asp-controller="Post"
                                   asp-action="Details"
                                   asp-route-id="@post.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    View post
                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

        @if (Model.ContributionTotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination">

                    <li class="page-item @(Model.ContributionPage > 1 ? "" : "disabled")">
                        <a class="page-link"
                           asp-controller="Profile"
                           asp-action="Index"
                           asp-route-username="@Model.User.UserName"
                           asp-route-page="@(Model.ContributionPage - 1)">
                            Previous
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">
                            @Model.ContributionPage / @Model.ContributionTotalPages
                        </span>
                    </li>

                    <li class="page-item @(Model.ContributionPage < Model.ContributionTotalPages ? "" : "disabled")">
                        <a class="page-link"
                           asp-controller="Profile"
                           asp-action="Index"
                           asp-route-username="@Model.User.UserName"
                           asp-route-page="@(Model.ContributionPage + 1)">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </section>

</div>
