@model PROJECT2106.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Registration";
}

<h2>Registration</h2>

<div style="max-width: 400px;">
    <form method="post">
    @Html.AntiForgeryToken()
        <div asp-validation-summary="All" style="color: red;"></div>

        <div style="margin-bottom: 10px;">
            <label>Username:</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" style="color: red;"></span>
        </div>

        <div style="margin-bottom: 10px;">
            <label>Email:</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" style="color: red;"></span>
        </div>

        <div style="margin-bottom: 10px;">
            <label>Password:</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" style="color: red;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label>Confirm Password:</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" style="color: red;"></span>
        </div>

        <button type="submit" class="btn btn-primary">Register</button>
        <a asp-action="Login" style="margin-left: 10px;">Already have an account?</a>
    </form>
</div>