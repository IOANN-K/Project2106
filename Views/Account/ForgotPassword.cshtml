@model PROJECT2106.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-shell">
    <section class="auth-card surface-card">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true">
                <img src="~/images/brand/atlas-icon.png" alt="" class="brand-icon" />
            </span>
            <span><strong>Atlas</strong><small>Explorer Network</small></span>
        </div>
        <p class="page-eyebrow">Account recovery</p>
        <h1>Reset your password</h1>
        <p class="text-muted mb-4">Enter your account email and we’ll send you a secure reset link.</p>

        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Send reset link</button>
            <p class="text-center text-muted small mt-3 mb-0"><a asp-action="Login">Back to login</a></p>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
