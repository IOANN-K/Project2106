@model PROJECT2106.Models.Place
@{ ViewData["Title"] = "Delete Place"; }
<div class="page-shell page-shell-narrow"><a asp-action="Details" asp-route-id="@Model.Id" class="breadcrumb-link">← Back to place</a><header class="page-header"><div><p class="page-eyebrow text-danger">Destructive action</p><h1 class="page-title page-title-sm">Delete @Model.Name?</h1><p class="page-subtitle">Posts eligible for removal with this place will also be deleted.</p></div></header><div class="danger-panel"><dl class="row mb-4"><dt class="col-sm-4">Place</dt><dd class="col-sm-8">@Model.Name</dd><dt class="col-sm-4">Coordinates</dt><dd class="col-sm-8">@Model.Latitude, @Model.Longitude</dd></dl><form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="action-toolbar">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Delete place</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></form></div></div>
