@model PROJECT2106.ViewModels.PlaceDetailsViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Place.Name;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var canAttemptDelete = User.Identity?.IsAuthenticated == true &&
        (Model.Place.CreatedByUserId == currentUserId || User.IsInRole("Admin"));
    var category = Model.Place.SystemCategory?.ToString() ?? Model.Place.CustomCategory?.Name ?? "Uncategorized";
}

<div class="page-shell">
    <a asp-controller="Map" asp-action="Index" class="breadcrumb-link"><span aria-hidden="true">←</span> Back to Explore</a>
    <header class="page-header">
        <div>
            <span class="category-badge">@category</span>
            <h1 class="page-title mt-2">@Model.Place.Name</h1>
            <div class="metadata-row mt-2">
                <span>Created by <strong>@(Model.Place.CreatedByUser?.UserName ?? "Unknown user")</strong></span>
                <span>@Model.Place.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
            </div>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="action-toolbar">
                <a asp-controller="Post" asp-action="Create" asp-route-placeId="@Model.Place.Id" class="btn btn-primary">Add contribution</a>
                @if (canAttemptDelete)
                {
                    <a asp-action="Delete" asp-route-id="@Model.Place.Id" class="btn btn-outline-danger">Delete</a>
                }
            </div>
        }
    </header>

    <div class="place-detail-grid">
        <section class="content-card">
            <p class="page-eyebrow">About this place</p>
            <h2 class="section-title">Field information</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Place.Description))
            {
                <p class="pre-line mt-3 mb-0">@Model.Place.Description</p>
            }
            else
            {
                <p class="text-muted mt-3 mb-0">No description has been added yet.</p>
            }
            <div class="detail-list">
                <div class="detail-item"><span>Latitude</span><strong>@Model.Place.Latitude.ToString("F6")</strong></div>
                <div class="detail-item"><span>Longitude</span><strong>@Model.Place.Longitude.ToString("F6")</strong></div>
                <div class="detail-item"><span>Contributions</span><strong>@Model.PostCount</strong></div>
            </div>
        </section>

        <aside class="content-card">
            <p class="page-eyebrow">Explorer rating</p>
            <div class="rating-score"><strong>@(Model.AverageRating?.ToString("0.0") ?? "0.0")</strong><span>/ 5</span></div>
            <p class="text-muted small">@(Model.RatingCount == 0 ? "No ratings yet" : $"Based on {Model.RatingCount} rating(s)")</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (TempData["RatingError"] is string ratingError) { <div class="alert alert-danger py-2">@ratingError</div> }
                <form asp-controller="Place" asp-action="Rate" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PlaceId" value="@Model.Place.Id" />
                    <label class="form-label" for="place-rating">Your rating</label>
                    <select id="place-rating" name="Value" class="form-select mb-2" required>
                        <option value="">Choose a score</option>
                        @for (var value = 1; value <= 5; value++)
                        {
                            if (Model.CurrentUserRating == value) { <option value="@value" selected>@value — @(value == 5 ? "Exceptional" : value == 4 ? "Great" : value == 3 ? "Good" : value == 2 ? "Fair" : "Poor")</option> }
                            else { <option value="@value">@value — @(value == 5 ? "Exceptional" : value == 4 ? "Great" : value == 3 ? "Good" : value == 2 ? "Fair" : "Poor")</option> }
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm">@(Model.CurrentUserRating.HasValue ? "Update rating" : "Rate place")</button>
                </form>
            }
        </aside>
    </div>

    <div class="section-heading">
        <div><p class="page-eyebrow mb-1">Community field notes</p><h2 class="section-title">Contributions <span class="text-muted">@Model.PostCount</span></h2></div>
        <div class="segmented-control" role="group" aria-label="Contribution sorting">
            <a asp-action="Details" asp-route-id="@Model.Place.Id" asp-route-sort="newest" class="btn @(Model.Sort == "newest" ? "active" : "")">Newest</a>
            <a asp-action="Details" asp-route-id="@Model.Place.Id" asp-route-sort="oldest" class="btn @(Model.Sort == "oldest" ? "active" : "")">Oldest</a>
            <a asp-action="Details" asp-route-id="@Model.Place.Id" asp-route-sort="most-liked" class="btn @(Model.Sort == "most-liked" ? "active" : "")">Most liked</a>
            <a asp-action="Details" asp-route-id="@Model.Place.Id" asp-route-sort="most-discussed" class="btn @(Model.Sort == "most-discussed" ? "active" : "")">Discussed</a>
        </div>
    </div>

    @if (Model.Posts.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16v12H8l-4 4V5Z"/></svg></div>
            <h3>No contributions yet</h3><p>Be the first explorer to share a field note about this place.</p>
            @if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Post" asp-action="Create" asp-route-placeId="@Model.Place.Id" class="btn btn-primary">Add the first contribution</a> }
        </div>
    }
    else
    {
        <div class="feed-list feed-shell">
            @foreach (var item in Model.Posts)
            {
                var post = item.Post;
                var author = post.Author?.UserName ?? "Unknown user";
                var initial = author.Length > 0 ? author[..1].ToUpperInvariant() : "?";
                <article class="feed-card">
                    <header class="feed-card-header">
                        <div class="author-block"><span class="avatar avatar-md">@initial</span><div><strong>@author</strong><small>@post.CreatedAt.ToString("dd MMM yyyy, HH:mm") @if (post.IsEdited) { <span>· edited</span> }</small></div></div>
                        <span class="category-badge">Field note</span>
                    </header>
                    <div class="feed-card-body">
                        <p class="pre-line">@post.Content</p>
                        <partial name="_PostMediaGallery" model="post.Media" />
                    </div>
                    <footer class="feed-card-footer">
                        <div class="engagement"><span>@item.LikeCount likes</span><span>@item.DislikeCount dislikes</span><span>@item.CommentCount comments</span></div>
                        <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">View contribution</a>
                    </footer>
                </article>
            }
        </div>
    }

    @if (Model.TotalPostPages > 1)
    {
        <nav class="mt-4" aria-label="Contribution pages"><ul class="pagination">
            <li class="page-item @(Model.PostPage > 1 ? "" : "disabled")"><a class="page-link" asp-action="Details" asp-route-id="@Model.Place.Id" asp-route-sort="@Model.Sort" asp-route-page="@(Model.PostPage - 1)">Previous</a></li>
            <li class="page-item disabled"><span class="page-link">@Model.PostPage / @Model.TotalPostPages</span></li>
            <li class="page-item @(Model.PostPage < Model.TotalPostPages ? "" : "disabled")"><a class="page-link" asp-action="Details" asp-route-id="@Model.Place.Id" asp-route-sort="@Model.Sort" asp-route-page="@(Model.PostPage + 1)">Next</a></li>
        </ul></nav>
    }
</div>
