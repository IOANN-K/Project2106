@model PROJECT2106.ViewModels.PlaceDetailsViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Place.Name;

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    var canAttemptDelete =
        User.Identity?.IsAuthenticated == true &&
        (Model.Place.CreatedByUserId == currentUserId ||
         User.IsInRole("Admin"));
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="mb-2">@Model.Place.Name</h1>

            <div class="text-muted">
                Created by
                <strong>@(Model.Place.CreatedByUser?.UserName ?? "Unknown user")</strong>
                on
                @Model.Place.CreatedAt.ToString("dd MMM yyyy, HH:mm")
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="d-flex gap-2">
                <a asp-controller="Post"
                   asp-action="Create"
                   asp-route-placeId="@Model.Place.Id"
                   class="btn btn-primary">
                    Add Post
                </a>

                @if (canAttemptDelete)
                {
                    <a asp-action="Delete"
                       asp-route-id="@Model.Place.Id"
                       class="btn btn-outline-danger">
                        Delete Place
                    </a>
                }
            </div>
        }
    </div>

    <div class="row g-4 mb-5">

        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">Place information</h5>

                    <dl class="row mb-0">

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">
                            @if (Model.Place.SystemCategory.HasValue)
                            {
                                <span class="badge text-bg-primary">
                                    @Model.Place.SystemCategory
                                </span>
                            }
                            else if (Model.Place.CustomCategory != null)
                            {
                                <span class="badge text-bg-secondary">
                                    @Model.Place.CustomCategory.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">Unknown</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Latitude</dt>
                        <dd class="col-sm-8">
                            @Model.Place.Latitude.ToString("F6")
                        </dd>

                        <dt class="col-sm-4">Longitude</dt>
                        <dd class="col-sm-8">
                            @Model.Place.Longitude.ToString("F6")
                        </dd>

                        <dt class="col-sm-4">Posts</dt>
                        <dd class="col-sm-8">
                            @Model.PostCount
                        </dd>

                    </dl>

                    @if (!string.IsNullOrWhiteSpace(Model.Place.Description))
                    {
                        <hr />

                        <p class="mb-0">
                            @Model.Place.Description
                        </p>
                    }

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">Rating</h5>

                    @if (Model.AverageRating.HasValue)
                    {
                        <div class="fs-3 fw-bold">
                            @Model.AverageRating.Value.ToString("0.0") / 5
                        </div>

                        <div class="text-muted mb-3">
                            @Model.RatingCount rating(s)
                        </div>
                    }
                    else
                    {
                        <div class="fs-3 fw-bold">
                            0.0 / 5
                        </div>

                        <div class="text-muted mb-3">
                            No ratings yet.
                        </div>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (TempData["RatingError"] is string ratingError)
                        {
                            <div class="alert alert-danger py-2">
                                @ratingError
                            </div>
                        }

                        <form asp-controller="Place"
                              asp-action="Rate"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="PlaceId"
                                   value="@Model.Place.Id" />

                            <label class="form-label">
                                Your rating
                            </label>

                            <select name="Value"
                                    class="form-select mb-2"
                                    required>
                                <option value="">Choose...</option>

                                @for (var value = 1; value <= 5; value++)
                                {
                                    if (Model.CurrentUserRating == value)
                                    {
                                        <option value="@value" selected>
                                            @value
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@value">
                                            @value
                                        </option>
                                    }
                                }
                            </select>

                            <button type="submit"
                                    class="btn btn-primary btn-sm">
                                @(Model.CurrentUserRating.HasValue
                                    ? "Update rating"
                                    : "Rate place")
                            </button>
                        </form>
                    }

                </div>
            </div>
        </div>

    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">

        <div>
            <h2 class="h4 mb-0">
                Posts
                <span class="text-muted">(@Model.PostCount)</span>
            </h2>
        </div>

        <div class="btn-group" role="group" aria-label="Post sorting">

            <a asp-action="Details"
               asp-route-id="@Model.Place.Id"
               asp-route-sort="newest"
               class="btn @(Model.Sort == "newest" ? "btn-dark" : "btn-outline-dark")">
                Newest
            </a>

            <a asp-action="Details"
               asp-route-id="@Model.Place.Id"
               asp-route-sort="oldest"
               class="btn @(Model.Sort == "oldest" ? "btn-dark" : "btn-outline-dark")">
                Oldest
            </a>

            <a asp-action="Details"
               asp-route-id="@Model.Place.Id"
               asp-route-sort="most-liked"
               class="btn @(Model.Sort == "most-liked" ? "btn-dark" : "btn-outline-dark")">
                Most liked
            </a>

            <a asp-action="Details"
               asp-route-id="@Model.Place.Id"
               asp-route-sort="most-discussed"
               class="btn @(Model.Sort == "most-discussed" ? "btn-dark" : "btn-outline-dark")">
                Most discussed
            </a>

        </div>

    </div>

    @if (Model.Posts.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">

                <h3 class="h5">No posts yet</h3>

                <p class="text-muted mb-3">
                    Nobody has shared anything about this place yet.
                </p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Post"
                       asp-action="Create"
                       asp-route-placeId="@Model.Place.Id"
                       class="btn btn-primary">
                        Add the first post
                    </a>
                }

            </div>
        </div>
    }
    else
    {
        <div class="d-grid gap-3">

            @foreach (var item in Model.Posts)
            {
                var post = item.Post;

                <article class="card">
                    <div class="card-body">

                        <div class="d-flex justify-content-between gap-3 mb-3">

                            <div>
                                <strong>
                                    @(post.Author?.UserName ?? "Unknown user")
                                </strong>

                                <div class="small text-muted">
                                    @post.CreatedAt.ToString("dd MMM yyyy, HH:mm")

                                    @if (post.IsEdited)
                                    {
                                        <span class="ms-1">
                                            · edited
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="small text-muted">
                                @item.LikeCount like(s)
                                ·
                                @item.DislikeCount dislike(s)
                                ·
                                @item.CommentCount comment(s)
                            </div>

                        </div>

                        <p class="mb-3"
                        style="white-space: pre-wrap;">@post.Content</p>

                        <partial name="_PostMediaGallery"
                                 model="post.Media" />

                        <a asp-controller="Post"
                        asp-action="Details"
                        asp-route-id="@post.Id"
                        class="btn btn-sm btn-outline-secondary">
                            Open post
                        </a>

                    </div>
                </article>
            }

        </div>
    }

    @if (Model.TotalPostPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination">

                <li class="page-item @(Model.PostPage > 1 ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Details"
                       asp-route-id="@Model.Place.Id"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.PostPage - 1)">
                        Previous
                    </a>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">
                        @Model.PostPage / @Model.TotalPostPages
                    </span>
                </li>

                <li class="page-item @(Model.PostPage < Model.TotalPostPages ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Details"
                       asp-route-id="@Model.Place.Id"
                       asp-route-sort="@Model.Sort"
                       asp-route-page="@(Model.PostPage + 1)">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>
