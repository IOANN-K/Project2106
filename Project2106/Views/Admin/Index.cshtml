@model PROJECT2106.ViewModels.AdminDashboardViewModel
@{ ViewData["Title"] = "Admin Panel"; }
<div class="page-shell"><header class="page-header"><div><p class="page-eyebrow">Operations</p><h1 class="page-title page-title-sm">Admin panel</h1><p class="page-subtitle">A compact overview of the Atlas community.</p></div></header><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><span class="stat-value">@Model.UserCount</span><span class="stat-label">Explorers</span></div></div><div class="col-md-4"><div class="stat-card"><span class="stat-value">@Model.PostCount</span><span class="stat-label">Contributions</span></div></div><div class="col-md-4"><div class="stat-card"><span class="stat-value">@Model.CommentCount</span><span class="stat-label">Comments</span></div></div></div><section class="surface-card overflow-hidden"><div class="card-header">Registered explorers</div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Registered</th></tr></thead><tbody>@foreach (var user in Model.Users.Items) { <tr><td>@user.UserName</td><td>@user.Email</td><td>@user.CreatedAt.ToString("dd MMM yyyy")</td></tr> }</tbody></table></div></section>@if (Model.Users.TotalPages > 1) { <nav class="mt-4"><ul class="pagination"><li class="page-item @(Model.Users.HasPreviousPage ? "" : "disabled")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Users.Page - 1)">Previous</a></li><li class="page-item disabled"><span class="page-link">@Model.Users.Page / @Model.Users.TotalPages</span></li><li class="page-item @(Model.Users.HasNextPage ? "" : "disabled")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Users.Page + 1)">Next</a></li></ul></nav> }</div>
