@model PROJECT2106.ViewModels.CustomCategoryEditViewModel
@{ ViewData["Title"] = "Edit Custom Category"; }

<div class="page-shell page-shell-narrow">
    <header class="page-header"><div><p class="page-eyebrow">Personal taxonomy</p><h1 class="page-title page-title-sm">Edit custom category</h1></div></header>
    <form method="post" enctype="multipart/form-data" class="content-card">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (!string.IsNullOrWhiteSpace(Model.ExistingIconPath))
        {
            <div class="category-icon-current mb-3"><img src="@Model.ExistingIconPath" alt="Current category icon" class="category-icon-preview" onerror="this.parentElement.classList.add('d-none')" /><span>Current marker icon</span></div>
        }
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="mb-4"><label asp-for="Icon" class="form-label">Replace marker icon <span class="text-muted">(optional)</span></label><input asp-for="Icon" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" /><span asp-validation-for="Icon" class="text-danger small"></span><div class="form-text">Leave empty to keep the current icon. Maximum 2 MB.</div></div>
        <div class="action-toolbar"><button type="submit" class="btn btn-primary">Save changes</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
