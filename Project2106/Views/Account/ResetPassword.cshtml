@model PROJECT2106.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-shell">
    <section class="auth-card surface-card">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true">
                <img src="~/images/brand/atlas-icon.png" alt="" class="brand-icon" />
            </span>
            <span><strong>Atlas</strong><small>Explorer Network</small></span>
        </div>
        <p class="page-eyebrow">Account security</p>
        <h1>Choose a new password</h1>
        <p class="text-muted mb-4">Use a strong password you haven’t used for this account before.</p>

        <form method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Reset password</button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
