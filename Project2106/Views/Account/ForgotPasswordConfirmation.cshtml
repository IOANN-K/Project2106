@{
    ViewData["Title"] = "Check Your Email";
}

<div class="auth-shell">
    <section class="auth-card surface-card text-center">
        <div class="empty-state-icon mx-auto" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 5h18v14H3V5Zm0 1 9 7 9-7" /></svg>
        </div>
        <p class="page-eyebrow mt-3">Check your inbox</p>
        <h1>Reset link requested</h1>
        <p class="text-muted mb-4">If an Atlas account exists for that email, a password reset link has been sent. Check your spam folder too.</p>
        <a asp-action="Login" class="btn btn-primary">Return to login</a>
    </section>
</div>
