@model PROJECT2106.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="page-shell page-shell-narrow">
    <a asp-controller="Profile" asp-action="Index" asp-route-username="@User.Identity?.Name" class="breadcrumb-link">← Back to profile</a>
    <header class="page-header">
        <div>
            <p class="page-eyebrow">Account security</p>
            <h1 class="page-title page-title-sm">Change password</h1>
            <p class="page-subtitle">Confirm your current password, then choose a new one.</p>
        </div>
    </header>

    <form method="post" class="content-card settings-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label"></label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <div class="action-toolbar">
            <button type="submit" class="btn btn-primary">Change password</button>
            <a asp-controller="Profile" asp-action="Index" asp-route-username="@User.Identity?.Name" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
