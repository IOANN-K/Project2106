@{
    ViewData["Title"] = "Password Reset";
}

<div class="auth-shell">
    <section class="auth-card surface-card text-center">
        <div class="empty-state-icon mx-auto" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
        </div>
        <p class="page-eyebrow mt-3">Account secured</p>
        <h1>Password updated</h1>
        <p class="text-muted mb-4">Your Atlas password has been reset. You can now sign in with the new password.</p>
        <a asp-action="Login" class="btn btn-primary">Log in</a>
    </section>
</div>
