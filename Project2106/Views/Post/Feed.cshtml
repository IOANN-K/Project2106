@model PROJECT2106.ViewModels.PagedResult<PROJECT2106.ViewModels.FeedItemViewModel>
@using PROJECT2106.Models
@{
    ViewData["Title"] = "My Feed";
}

<div class="page-shell">
    <header class="page-header">
        <div><p class="page-eyebrow">Your network</p><h1 class="page-title page-title-sm">Explorer feed</h1><p class="page-subtitle">Fresh field notes from the people you follow.</p></div>
        <a asp-controller="Profile" asp-action="Search" class="btn btn-outline-secondary">Find explorers</a>
    </header>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm10-4v6m3-3h-6"/></svg></div>
            <h2>Your feed is waiting for a trail</h2>
            <p>Follow other explorers and their newest contributions will appear here automatically.</p>
            <div class="action-toolbar justify-content-center"><a asp-controller="Profile" asp-action="Search" class="btn btn-primary">Find explorers</a><a asp-controller="Map" asp-action="Index" class="btn btn-outline-secondary">Explore map</a></div>
        </div>
    }
    else
    {
        <div class="contribution-grid">
            @foreach (var item in Model.Items)
            {
                var initial = string.IsNullOrWhiteSpace(item.AuthorUsername) ? "?" : item.AuthorUsername[..1].ToUpperInvariant();
                <article class="feed-card">
                    <header class="feed-card-header">
                        <div class="author-block">
                            <a asp-controller="Profile" asp-action="Index" asp-route-username="@item.AuthorUsername" class="author-avatar-link" aria-label="View @item.AuthorUsername's profile">@if (!string.IsNullOrWhiteSpace(item.AuthorAvatarUrl)) { <img src="@item.AuthorAvatarUrl" alt="" class="author-avatar-image avatar-md" loading="lazy" /><span class="avatar avatar-md avatar-fallback d-none">@initial</span> } else { <span class="avatar avatar-md">@initial</span> }</a>
                            <div class="author-copy"><a asp-controller="Profile" asp-action="Index" asp-route-username="@item.AuthorUsername" class="author-link">@item.AuthorUsername</a><small>@item.CreatedAt.ToString("dd MMM yyyy, HH:mm") @if (item.IsEdited) { <span>· edited</span> }</small></div>
                        </div>
                        <span class="category-badge">@item.Category</span>
                    </header>
                    <div class="feed-card-body">
                        <div class="place-context">Contribution to <a asp-controller="Place" asp-action="Details" asp-route-id="@item.PlaceId"><strong>@item.PlaceName</strong></a></div>
                        <p class="pre-line">@item.Excerpt</p>
                        @if (item.Media != null)
                        {
                            <div class="post-media-item mt-3">
                                @if (item.Media.MediaType == PostMediaType.Image)
                                {
                                    <img src="@item.Media.RelativePath" alt="@item.Media.OriginalFileName" class="post-media-image" loading="lazy" />
                                    <div class="post-media-fallback alert alert-secondary d-none mb-0">Image unavailable</div>
                                }
                                else
                                {
                                    <video controls preload="metadata" class="post-media-video"><source src="@item.Media.RelativePath" type="@item.Media.MimeType" /></video>
                                    <div class="post-media-fallback alert alert-secondary d-none mb-0">Video unavailable</div>
                                }
                            </div>
                        }
                    </div>
                    <footer class="feed-card-footer">
                        <div class="social-actions" aria-label="Contribution activity">
                            <span class="social-action social-action-like"><svg class="social-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3m0 11V11l4-9c2 0 3 1.5 2.5 3.5L13 8h6a3 3 0 0 1 3 3l-1 7a4 4 0 0 1-4 4H7Z"/></svg><span class="social-action-count">@item.LikeCount</span></span>
                            <span class="social-action social-action-comment"><svg class="social-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z"/></svg><span class="social-action-count">@item.CommentCount</span></span>
                        </div>
                        <div class="action-toolbar"><a asp-controller="Place" asp-action="Details" asp-route-id="@item.PlaceId" class="btn btn-sm btn-quiet">View place</a><a asp-controller="Post" asp-action="Details" asp-route-id="@item.PostId" class="btn btn-sm btn-primary">View contribution</a></div>
                    </footer>
                </article>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Feed pages"><ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")"><a class="page-link" asp-action="Feed" asp-route-page="@(Model.Page - 1)">Previous</a></li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")"><a class="page-link" asp-action="Feed" asp-route-page="@(Model.Page + 1)">Next</a></li>
        </ul></nav>
    }
</div>
