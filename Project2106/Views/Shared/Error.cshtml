@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="page-shell page-shell-narrow"><div class="empty-state"><div class="empty-state-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 9v4m0 4h.01M10.3 3.7 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"/></svg></div><p class="page-eyebrow">Something went off trail</p><h1 class="page-title page-title-sm">We couldn’t complete that request.</h1><p>Please return to the map and try again. If the problem continues, share the request identifier with the project team.</p>@if (Model.ShowRequestId) { <p class="small"><strong>Request ID:</strong> <code>@Model.RequestId</code></p> }<a asp-controller="Map" asp-action="Index" class="btn btn-primary">Return to Explore</a></div></div>
